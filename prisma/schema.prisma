generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  DENTIST
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum ConversationStatus {
  AI_ACTIVE
  HUMAN_REQUIRED
  HUMAN_ACTIVE
  CLOSED
}

enum ConversationChannel {
  WEBSITE
  FACEBOOK_MESSENGER
}

enum MessageSenderType {
  PATIENT
  AI
  STAFF
  SYSTEM
}

model Clinic {
  id                 String        @id @default(cuid())
  slug               String        @unique
  name               String
  address            String
  phone              String
  email              String
  timeZone           String        @default("Asia/Manila")
  openingHours       String
  appointmentPolicy  String        @default("")
  cancellationPolicy String        @default("")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  hours              ClinicHour[]
  blockedDates       BlockedDate[]
}

model ClinicHour {
  id        String    @id @default(cuid())
  clinicId  String
  day       DayOfWeek
  startTime String
  endTime   String
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, day])
}

model BlockedDate {
  id        String   @id @default(cuid())
  clinicId  String
  date      String
  reason    String?
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@index([date])
}

model User {
  id                    String         @id @default(cuid())
  name                  String
  email                 String         @unique
  passwordHash          String
  role                  UserRole       @default(STAFF)
  active                Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  assignedConversations Conversation[] @relation("AssignedStaff")
  sessions              Session[]
}

model Patient {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  email         String         @unique
  phone         String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  appointments  Appointment[]
  conversations Conversation[]
}

model Dentist {
  id              String        @id @default(cuid())
  name            String
  title           String
  bio             String
  specializations String[]
  photoUrl        String?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  schedules       Schedule[]
  appointments    Appointment[]
}

model Service {
  id              String        @id @default(cuid())
  name            String        @unique
  description     String
  durationMinutes Int
  active          Boolean       @default(true)
  displayOrder    Int           @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]
}

model Faq {
  id           String   @id @default(cuid())
  question     String   @unique
  answer       String
  displayOrder Int      @unique
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Schedule {
  id        String    @id @default(cuid())
  dentistId String
  day       DayOfWeek
  startTime String
  endTime   String
  dentist   Dentist   @relation(fields: [dentistId], references: [id], onDelete: Cascade)

  @@unique([dentistId, day])
}

model Appointment {
  id                 String            @id @default(cuid())
  patientId          String
  dentistId          String
  serviceId          String
  scheduledAt        DateTime
  endAt              DateTime
  status             AppointmentStatus @default(PENDING)
  notes              String?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  dentist            Dentist           @relation(fields: [dentistId], references: [id], onDelete: Restrict)
  service            Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([dentistId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@index([dentistId, scheduledAt])
}

model Conversation {
  id               String              @id @default(cuid())
  patientId        String
  channel          ConversationChannel
  channelReference String?
  status           ConversationStatus  @default(AI_ACTIVE)
  assignedStaffId  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  patient          Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  assignedStaff    User?               @relation("AssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages         Message[]

  @@index([patientId, updatedAt])
  @@index([status, updatedAt])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderType     MessageSenderType
  content        String
  metadata       Json?
  createdAt      DateTime          @default(now())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}
