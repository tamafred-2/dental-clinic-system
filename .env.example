# Application
NODE_ENV=development

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# API
API_PORT=4000
API_HOST=127.0.0.1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dental_clinic

# Authentication
# Days until an inactive browser session expires.
SESSION_TTL_DAYS=7

# AI provider: openai, agentrouter, or groq for free-tier testing.
AI_PROVIDER=openai

# OpenAI (lower-cost default; API billing is still required)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# AgentRouter (use this instead of OPENAI_API_KEY when OPENAI_BASE_URL is AgentRouter)
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_WIRE_API=responses

# Knowledge retrieval: local is free and deterministic for development.
# Use openai for stronger semantic retrieval, then reindex the knowledge base.
KNOWLEDGE_EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq test provider (rate-limited free plan; never expose this key to the web)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Meta
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=

# n8n
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Redis
REDIS_URL=redis://localhost:6379
